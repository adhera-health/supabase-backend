{
  "compilerOptions": {
    "strict": true,
    "lib": ["deno.window", "deno.unstable"]
  },
  "nodeModulesDir": "auto",
  "imports": {
    "@shared/": "./src/shared/",
    "@domain/": "./src/types/",
    "@integrations/": "./src/integrations/",
    "@std/assert": "jsr:@std/assert@^1.0.19",
    "@std/testing/mock": "jsr:@std/testing@^1.0.19/mock",
    "@supabase/supabase-js": "npm:@supabase/supabase-js@2.108.1",
    "zod": "npm:zod@3.24.4",
    "hono": "jsr:@hono/hono@^4.7.10",
    "sanitize-html": "npm:sanitize-html@^2.17.6",
    "@types/sanitize-html": "npm:@types/sanitize-html@^2.16.1"
  },
  "tasks": {
    "seed:admin": "deno run --env-file=.env --allow-env --allow-net scripts/seed-dev-admin.ts",
    "run:reminders": "deno run --env-file=.env --allow-env --allow-net scripts/run-reminders-dev.ts",
    "test:e2e": "deno run --env-file=.env --allow-env --allow-net scripts/run-e2e-flow-dev.ts"
  }
}
