# =============================================================================
# Local development — copy to `.env` and run:
#   supabase start && deno task seed:admin && supabase functions serve --env-file .env
# Production secrets go on hosted Supabase Edge Functions (not this file).
# Full list: .docs/client-handoff.md#production-environment-variables
# =============================================================================

SUPABASE_URL=http://127.0.0.1:54321

SUPABASE_ANON_KEY=your-anon-key-here

SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# One of: development | test | staging | production.
# Anything else — including unset or a typo — resolves to `production` so security
# controls (CORS allowlist, secret gates, dev-only logging) fail closed rather than
# silently downgrading. Set it explicitly in every environment.
ENVIRONMENT=development

LOG_LEVEL=debug

# --- Required in EVERY environment (routes return 500 until these are set) ---
# Guards POST /reminders/run — triggers a batch patient email send.
REMINDER_CRON_SECRET=change-me-in-production
# Guards POST /license-reservation/get-by-email — returns PII by email and runs
# with verify_jwt = false, so this header is its only authentication.
LICENSE_RESERVATION_SECRET=change-me-in-production

# Local dev admin (deno task seed:admin) — development only; never use on production
DEV_ADMIN_EMAIL=admin@adhera.dev
DEV_ADMIN_PASSWORD=AdminPass123
# DEV_ADMIN_CLIENT_ID=
# DEV_ADMIN_PROGRAM_ID=
# DEV_ADMIN_LICENSE_CLIENT_ID=
# DEV_ADMIN_LICENSE_PROGRAM_ID=

# LICENSE_CLIENT_ID=
# LICENSE_PROGRAM_ID=
# LICENSE_CORE_API_HOST=

# Client dropdown → GET /invitations/clients
# ADHERA_CORE_BASE_URL=http://host.docker.internal:7006
# ADHERA_CORE_ACTIVE_CLIENTS_PATH=/api/v1/active-clients
# Program dropdown → GET /invitations/clients/:clientId/programs
# ADHERA_CORE_CLIENT_PROGRAMS_PATH_TEMPLATE=/api/v1/clients/{clientId}/programs
# ADHERA_CORE_TIMEOUT_MS=10000
# ADHERA_CORE_AUTH_MODE=none
# ADHERA_CORE_AUTH_MODE=bearer
# ADHERA_CORE_API_TOKEN=
# ADHERA_CORE_AUTH_MODE=api_key_header
# ADHERA_CORE_API_KEY=
# ADHERA_CORE_API_KEY_HEADER=X-Api-Key

# Patient app origin (onboarding links, reminder opt-out URLs)
PATIENT_APP_BASE_URL=http://localhost:3000

# Invitation/reminder emails (Resend)
# Local: leave ENABLE_RESEND_IN_DEV unset/false — copy onboarding_token from function logs
# Production: RESEND_API_KEY + INVITATION_FROM_EMAIL are required (see client-handoff.md)
# ENABLE_RESEND_IN_DEV=true
# RESEND_API_KEY=
# INVITATION_FROM_EMAIL=onboarding@resend.dev

# App store / download link for invitation emails (optional)
# PATIENT_APP_DOWNLOAD_URL=https://apps.apple.com/...

# Public URL prefix for uploaded consent PDFs (optional; defaults from SUPABASE_URL + bucket)
# CONSENT_DOCUMENT_PUBLIC_BASE_URL=https://<project>.supabase.co/storage/v1/object/public/consent-documents

# License create at complete-onboarding (POST /onboarding/complete-onboarding)
# LICENSE_SERVICE_BASE_URL=https://stage2.adheracare.com/license-manager
# LICENSE_AUTH0_DOMAIN=staging-adhera.us.auth0.com
# LICENSE_AUTH0_CLIENT_ID=
# LICENSE_AUTH0_CLIENT_SECRET=
# LICENSE_AUTH0_AUDIENCE=https://adheracare.com/license-manager
# Optional overrides:
# LICENSE_AUTH0_SCOPE=admin:licenses
# LICENSE_BATCH_PATH=/api/v1/licenses/batch
# LICENSE_TIMEOUT_MS=15000

# --- Production-required (set on hosted Supabase when ENVIRONMENT=production) ---
# REMINDER_CRON_SECRET + LICENSE_RESERVATION_SECRET are required in every
# environment — see the block near the top of this file.

CRON_SECRET=change-me-in-production
# ALLOWED_CORS_ORIGINS=https://patient-app.example.com,https://admin-dashboard.example.com
# OPT_OUT_TOKEN_SECRET=change-me-in-production

# --- Rate limits (optional overrides; defaults shown) ---
RATE_LIMIT_VALIDATE_TOKEN_MAX=60
RATE_LIMIT_VALIDATE_TOKEN_WINDOW_MS=60000
RATE_LIMIT_COMPLETE_ONBOARDING_MAX=10
RATE_LIMIT_COMPLETE_ONBOARDING_WINDOW_MS=60000
RATE_LIMIT_ONBOARDING_SIGNIN_MAX=5
RATE_LIMIT_ONBOARDING_SIGNIN_WINDOW_MS=1800000
RATE_LIMIT_OPT_OUT_MAX=30
RATE_LIMIT_OPT_OUT_WINDOW_MS=60000
RATE_LIMIT_LICENSE_LOOKUP_MAX=20
RATE_LIMIT_LICENSE_LOOKUP_WINDOW_MS=60000
RATE_LIMIT_ADMIN_WINDOW_MS=60000
RATE_LIMIT_ADMIN_SEND_MAX=30
RATE_LIMIT_ADMIN_CLIENTS_LIST_MAX=60
RATE_LIMIT_ADMIN_CLIENT_PROGRAMS_LIST_MAX=120
RATE_LIMIT_ADMIN_RESEND_MAX=20
RATE_LIMIT_ADMIN_DROP_OUT_MAX=30
RATE_LIMIT_ADMIN_CONSENT_UPLOAD_MAX=10
RATE_LIMIT_ADMIN_CONSENT_ACTIVATE_MAX=20
RATE_LIMIT_ADMIN_USER_CREATE_MAX=20
# rate_limits table cleanup (POST /rate-limits-cleanup/run, cron-triggered) — retention window in ms
RATE_LIMIT_CLEANUP_RETENTION_MS=86400000
